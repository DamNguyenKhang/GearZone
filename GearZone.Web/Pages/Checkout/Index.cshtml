                            </div>
                            <div class="relative flex justify-center text-xs uppercase tracking-widest font-bold">
                                <span class="px-3 bg-white dark:bg-[#1a202c] text-slate-400">Available Vouchers</span>
                            </div>
                        </div>

                        <!-- Voucher List Container -->
                        <div id="voucher-list" class="mt-6 space-y-3 max-h-[400px] overflow-y-auto pr-2 custom-scrollbar">
