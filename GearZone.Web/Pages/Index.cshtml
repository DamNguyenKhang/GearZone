@page
@model GearZone.Web.Pages.IndexModel
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using GearZone.Application.Features.Catalog.DTOs
@{
    ViewData["Title"] = "Marketplace Home";

    string GetToneBackground(string tone) => tone switch
    {
        "orange" => "bg-[#fff1e8] text-[#ff6b00]",
        "violet" => "bg-[#f2edff] text-violet-600",
        "sky" => "bg-[#eef6ff] text-sky-600",
        "emerald" => "bg-[#ecfbf4] text-emerald-600",
        "slate" => "bg-slate-100 text-slate-700",
        _ => "bg-[#e8f2ff] text-[#0261c7]"
    };

    string? primaryHeroImage = string.IsNullOrWhiteSpace(Model.HomePage.Hero.ImageUrl)
        ? null
        : Model.HomePage.Hero.ImageUrl;
    string? promoImage = string.IsNullOrWhiteSpace(Model.HomePage.PromoCard.ImageUrl)
        ? null
        : Model.HomePage.PromoCard.ImageUrl;
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        .gear-home {
            font-family: "Plus Jakarta Sans", sans-serif;
            background:
                radial-gradient(circle at top left, rgba(56, 157, 248, 0.18), transparent 30%),
                linear-gradient(180deg, #f4f8ff 0%, #f8fbff 50%, #f8fafc 100%);
            color: #0f172a;
            overflow-x: hidden;
        }

        .gear-home-shell {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        .gear-panel {
            border: 1px solid rgba(226, 232, 240, 0.9);
            background: rgba(255, 255, 255, 0.92);
            border-radius: 1.5rem;
            box-shadow: 0 20px 40px -28px rgba(15, 23, 42, 0.28);
        }

        .gear-hero-grid {
            display: grid;
            gap: 1rem;
        }

        .gear-hero-main {
            position: relative;
            overflow: hidden;
            border-radius: 1.9rem;
            background: linear-gradient(135deg, #0f172a 0%, #102a74 52%, #0e81eb 100%);
            color: white;
            min-height: 340px;
        }

        .gear-hero-main::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at top right, rgba(255, 255, 255, 0.16), transparent 28%),
                radial-gradient(circle at bottom left, rgba(255, 107, 0, 0.14), transparent 24%);
            pointer-events: none;
        }

        .gear-hero-copy {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 1.75rem;
            height: 100%;
            padding: 1.75rem;
        }

        .gear-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            width: fit-content;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.18);
            background: rgba(255, 255, 255, 0.1);
            padding: 0.45rem 0.9rem;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(239, 246, 255, 0.96);
            backdrop-filter: blur(12px);
        }

        .gear-hero-badge-dot {
            width: 0.45rem;
            height: 0.45rem;
            border-radius: 999px;
            background: #ffb36b;
        }

        .gear-hero-title {
            font-size: clamp(2rem, 4vw, 3.25rem);
            line-height: 0.98;
            font-weight: 800;
            letter-spacing: -0.05em;
        }

        .gear-hero-title span {
            display: block;
            color: #a8d8ff;
        }

        .gear-hero-description {
            max-width: 34rem;
            margin-top: 1rem;
            font-size: 0.95rem;
            line-height: 1.8;
            color: rgba(239, 246, 255, 0.84);
        }

        .gear-hero-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.65rem;
            margin-top: 1.5rem;
        }

        .gear-hero-pill {
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            padding: 0.55rem 0.9rem;
            font-size: 0.78rem;
            font-weight: 700;
            color: rgba(239, 246, 255, 0.94);
            backdrop-filter: blur(12px);
        }

        .gear-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .gear-hero-primary,
        .gear-hero-secondary {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border-radius: 1rem;
            padding: 0.9rem 1.1rem;
            font-size: 0.92rem;
            font-weight: 800;
            transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
        }

        .gear-hero-primary {
            background: #ff6b00;
            color: white;
            box-shadow: 0 18px 30px -20px rgba(255, 107, 0, 0.75);
        }

        .gear-hero-primary:hover,
        .gear-hero-secondary:hover {
            transform: translateY(-1px);
        }

        .gear-hero-secondary {
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.1);
            color: white;
            backdrop-filter: blur(12px);
        }

        .gear-hero-visual {
            position: relative;
            z-index: 1;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .gear-hero-image-frame {
            width: 100%;
            max-width: 340px;
            border-radius: 1.8rem;
            border: 1px solid rgba(255, 255, 255, 0.14);
            background: rgba(255, 255, 255, 0.1);
            padding: 0.75rem;
            box-shadow: 0 24px 60px -36px rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(14px);
        }

        .gear-hero-image-frame img {
            width: 100%;
            height: 270px;
            border-radius: 1.25rem;
            object-fit: cover;
        }

        .gear-promo-card {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 1rem;
            overflow: hidden;
            min-height: 340px;
            padding: 1.4rem;
        }

        .gear-promo-art {
            overflow: hidden;
            border-radius: 1.2rem;
            background: linear-gradient(135deg, #e0effe 0%, #eef4ff 62%, #fff1e8 100%);
            padding: 0.75rem;
        }

        .gear-promo-art img {
            width: 100%;
            height: 170px;
            border-radius: 1rem;
            object-fit: cover;
        }

        .gear-section {
            padding-top: 1.1rem;
            padding-bottom: 0.25rem;
        }

        .gear-section-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .gear-section-eyebrow {
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: #64748b;
        }

        .gear-section-title {
            margin-top: 0.35rem;
            font-size: 1.15rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: #0f172a;
        }

        .gear-section-description {
            margin-top: 0.2rem;
            font-size: 0.86rem;
            color: #64748b;
        }

        .gear-section-link {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: #0261c7;
        }

        .gear-quick-actions,
        .gear-categories,
        .gear-store-grid,
        .gear-product-grid {
            display: grid;
            gap: 0.9rem;
        }

        .gear-quick-actions {
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            margin-top: 1rem;
        }

        .gear-categories {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .gear-store-grid,
        .gear-product-grid {
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }

        .gear-quick-card,
        .gear-category-card,
        .gear-store-card {
            border: 1px solid rgba(226, 232, 240, 0.85);
            background: white;
            box-shadow: 0 16px 28px -24px rgba(15, 23, 42, 0.4);
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        }

        .gear-quick-card:hover,
        .gear-category-card:hover,
        .gear-store-card:hover {
            transform: translateY(-2px);
            border-color: rgba(14, 129, 235, 0.22);
            box-shadow: 0 20px 36px -24px rgba(14, 129, 235, 0.22);
        }

        .gear-quick-card {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            border-radius: 1.1rem;
            padding: 0.85rem 1rem;
        }

        .gear-category-card {
            border-radius: 1.15rem;
            padding: 1rem 0.85rem;
            text-align: center;
        }

        .gear-store-card {
            border-radius: 1.4rem;
            padding: 1.2rem;
        }

        .gear-tone-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.7rem;
            height: 2.7rem;
            border-radius: 1rem;
        }

        .gear-empty-panel {
            border-radius: 1.2rem;
            border: 1px dashed rgba(148, 163, 184, 0.4);
            padding: 2rem 1rem;
            text-align: center;
            color: #64748b;
            background: rgba(255, 255, 255, 0.65);
        }

        @@media (min-width: 768px) {
            .gear-home-shell {
                padding: 0 1.5rem;
            }

            .gear-hero-grid {
                grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.85fr);
            }

            .gear-hero-main {
                min-height: 380px;
            }

            .gear-hero-copy {
                padding: 2rem;
            }

            .gear-categories,
            .gear-store-grid,
            .gear-product-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (min-width: 1024px) {
            .gear-home-shell {
                padding: 0 2rem;
            }

            .gear-hero-main {
                display: grid;
                grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.7fr);
            }

            .gear-hero-visual {
                display: flex;
                padding: 1.8rem 1.6rem 1.8rem 0;
            }

            .gear-categories {
                grid-template-columns: repeat(6, minmax(0, 1fr));
            }

            .gear-store-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .gear-product-grid {
                grid-template-columns: repeat(5, minmax(0, 1fr));
            }
        }
    </style>
}

<div class="gear-home pb-12">
    <section class="pt-6 pb-4">
        <div class="gear-home-shell">
            <div class="gear-hero-grid">
                <section class="gear-hero-main">
                    <div class="gear-hero-copy">
                        <div>
                            <div class="gear-hero-badge">
                                <span class="gear-hero-badge-dot"></span>
                                @Model.HomePage.Hero.Eyebrow
                            </div>
                            <h1 class="gear-hero-title mt-5">
                                @Model.HomePage.Hero.Title
                                <span>@Model.HomePage.Hero.AccentTitle</span>
                            </h1>
                            <p class="gear-hero-description">@Model.HomePage.Hero.Description</p>
                            @if (Model.HomePage.Hero.Highlights.Any())
                            {
                                <div class="gear-hero-meta">
                                    @foreach (var highlight in Model.HomePage.Hero.Highlights)
                                    {
                                        <span class="gear-hero-pill">@highlight</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="gear-hero-actions">
                            <a href="@Model.HomePage.Hero.PrimaryHref" class="gear-hero-primary">
                                @Model.HomePage.Hero.PrimaryLabel
                                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                            </a>
                            <a href="@Model.HomePage.Hero.SecondaryHref" class="gear-hero-secondary">
                                @Model.HomePage.Hero.SecondaryLabel
                            </a>
                        </div>
                    </div>

                    <div class="gear-hero-visual">
                        @if (!string.IsNullOrWhiteSpace(primaryHeroImage))
                        {
                            <div class="gear-hero-image-frame">
                                <img src="@primaryHeroImage" alt="Featured GearZone product" loading="lazy" />
                            </div>
                        }
                    </div>
                </section>

                <a href="@Model.HomePage.PromoCard.Href" class="gear-panel gear-promo-card">
                    <div>
                        <p class="gear-section-eyebrow text-[#0261c7]">@Model.HomePage.PromoCard.Eyebrow</p>
                        <h2 class="mt-2 text-[1.55rem] font-extrabold leading-tight tracking-tight text-slate-900">@Model.HomePage.PromoCard.Title</h2>
                        <p class="mt-3 text-sm leading-6 text-slate-500">@Model.HomePage.PromoCard.Description</p>
                    </div>
                    <div class="gear-promo-art">
                        @if (!string.IsNullOrWhiteSpace(promoImage))
                        {
                            <img src="@promoImage" alt="@Model.HomePage.PromoCard.Title" loading="lazy" />
                        }
                    </div>
                    <div class="inline-flex items-center gap-2 text-sm font-bold text-[#ff6b00]">
                        @Model.HomePage.PromoCard.LinkLabel
                        <span class="material-symbols-outlined text-[18px]">trending_flat</span>
                    </div>
                </a>
            </div>

            <div class="gear-quick-actions">
                @foreach (var action in Model.HomePage.QuickActions)
                {
                    <a href="@action.Href" class="gear-quick-card">
                        <span class="gear-tone-icon @GetToneBackground(action.Tone)">
                            <span class="material-symbols-outlined text-[20px]">@action.Icon</span>
                        </span>
                        <div>
                            <p class="text-sm font-bold text-slate-900">@action.Title</p>
                            <p class="text-xs text-slate-500">@action.Subtitle</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="gear-section">
        <div class="gear-home-shell">
            <div class="gear-panel p-4 sm:p-5">
                <div class="gear-section-heading">
                    <div>
                        <p class="gear-section-eyebrow">Categories</p>
                        <h2 class="gear-section-title">Browse by hardware type</h2>
                    </div>
                    <a href="/products" class="gear-section-link">
                        View all
                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                    </a>
                </div>

                <div class="gear-categories">
                    @foreach (var category in Model.HomePage.Categories)
                    {
                        <a href="@category.Href" class="gear-category-card">
                            <span class="gear-tone-icon mx-auto @GetToneBackground(category.Tone)">
                                <span class="material-symbols-outlined text-[20px]">@category.Icon</span>
                            </span>
                            <p class="mt-3 text-sm font-bold text-slate-900">@category.Name</p>
                            <p class="mt-1 text-xs text-slate-500">@category.Subtitle</p>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="gear-section" id="home-flash-zone">
        <div class="gear-home-shell">
            <div class="gear-panel p-4 sm:p-5">
                <div class="gear-section-heading">
                    <div>
                        <p class="gear-section-eyebrow text-[#ff6b00]">@Model.HomePage.FlashRail.Eyebrow</p>
                        <h2 class="gear-section-title">@Model.HomePage.FlashRail.Title</h2>
                        <p class="gear-section-description">@Model.HomePage.FlashRail.Description</p>
                    </div>
                    <a href="@Model.HomePage.FlashRail.ViewAllHref" class="gear-section-link">
                        @Model.HomePage.FlashRail.ViewAllLabel
                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                    </a>
                </div>

                @if (Model.HomePage.FlashRail.Products.Any())
                {
                    <div class="gear-product-grid">
                        @foreach (var product in Model.HomePage.FlashRail.Products)
                        {
                            <partial name="/Pages/Shared/_ProductCard.cshtml"
                                     model="product"
                                     view-data='new ViewDataDictionary(ViewData) { ["ViewMode"] = "grid" }' />
                        }
                    </div>
                }
                else
                {
                    <div class="gear-empty-panel">No flash deal products are available yet.</div>
                }
            </div>
        </div>
    </section>

    <section class="gear-section">
        <div class="gear-home-shell">
            <div class="gear-panel p-4 sm:p-5">
                <div class="gear-section-heading">
                    <div>
                        <p class="gear-section-eyebrow">Official store</p>
                        <h2 class="gear-section-title">Verified marketplace desk</h2>
                        <p class="gear-section-description">Direct links into the seeded store profile and its live catalog.</p>
                    </div>
                </div>

                @if (Model.HomePage.Stores.Any())
                {
                    <div class="gear-store-grid">
                        @foreach (var store in Model.HomePage.Stores)
                        {
                            <a href="@store.Href" class="gear-store-card">
                                <div class="flex items-start gap-4">
                                    <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-[#eef6ff] text-lg font-black text-[#0261c7]">
                                        @if (!string.IsNullOrWhiteSpace(store.LogoUrl))
                                        {
                                            <img src="@store.LogoUrl" alt="@store.StoreName" class="h-full w-full object-cover" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span>@store.StoreName[0]</span>
                                        }
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <h3 class="truncate text-base font-extrabold text-slate-900">@store.StoreName</h3>
                                            <span class="rounded-full bg-[#eef6ff] px-2 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#0261c7]">Verified</span>
                                        </div>
                                        <p class="mt-2 text-sm text-slate-500">@(string.IsNullOrWhiteSpace(store.Description) ? "Official marketplace store with live seeded catalog data." : store.Description)</p>
                                    </div>
                                </div>
                                <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
                                    <div class="rounded-2xl bg-slate-50 px-3 py-3">
                                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Products</p>
                                        <p class="mt-1 text-lg font-extrabold text-slate-900">@store.ProductCount</p>
                                    </div>
                                    <div class="rounded-2xl bg-slate-50 px-3 py-3">
                                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Sold</p>
                                        <p class="mt-1 text-lg font-extrabold text-slate-900">@store.TotalSold</p>
                                    </div>
                                    <div class="rounded-2xl bg-slate-50 px-3 py-3">
                                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Reviews</p>
                                        <p class="mt-1 text-lg font-extrabold text-slate-900">@store.ReviewCount</p>
                                    </div>
                                    <div class="rounded-2xl bg-slate-50 px-3 py-3">
                                        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">Province</p>
                                        <p class="mt-1 text-sm font-bold text-slate-900">@store.Province</p>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="gear-empty-panel">No verified store is available yet.</div>
                }
            </div>
        </div>
    </section>

    <section class="gear-section">
        <div class="gear-home-shell">
            <div class="gear-panel p-4 sm:p-5">
                <div class="gear-section-heading">
                    <div>
                        <p class="gear-section-eyebrow">@Model.HomePage.RecommendedRail.Eyebrow</p>
                        <h2 class="gear-section-title">@Model.HomePage.RecommendedRail.Title</h2>
                        <p class="gear-section-description">@Model.HomePage.RecommendedRail.Description</p>
                    </div>
                    <a href="@Model.HomePage.RecommendedRail.ViewAllHref" class="gear-section-link">
                        @Model.HomePage.RecommendedRail.ViewAllLabel
                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                    </a>
                </div>

                @if (Model.HomePage.RecommendedRail.Products.Any())
                {
                    <div class="gear-product-grid">
                        @foreach (var product in Model.HomePage.RecommendedRail.Products)
                        {
                            <partial name="/Pages/Shared/_ProductCard.cshtml"
                                     model="product"
                                     view-data='new ViewDataDictionary(ViewData) { ["ViewMode"] = "grid" }' />
                        }
                    </div>
                }
                else
                {
                    <div class="gear-empty-panel">No recommended products are available yet.</div>
                }
            </div>
        </div>
    </section>
</div>
