@page
@model GearZone.Web.Pages.StoreOwner.Messages.IndexModel
@{
    ViewData["Title"] = "Tin nhắn khách hàng";
    ViewData["PageHeader"] = "Tin nhắn khách hàng";
    ViewData["ActivePage"] = "Messages";
    ViewData["Breadcrumb"] = new[] { "Tin nhắn" };
    Layout = "_StoreOwnerLayout";
}

<div class="space-y-5">
    <div>
        <p class="text-[11px] font-black uppercase tracking-[0.22em] text-orange-500">Shopee-close Webchat</p>
        <h1 class="mt-2 text-[28px] font-bold text-slate-900">Tin nhắn khách hàng</h1>
        <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-500">Trả lời khách hàng trong một khung chat phẳng, chặt và realtime hơn, gần trải nghiệm Shopee webchat.</p>
    </div>

    <partial name="/Pages/Shared/_ChatInboxLayout.cshtml" model="Model.Inbox" />
</div>

@section Styles {
    <partial name="/Pages/Shared/_ChatInboxStyles.cshtml" />
}

@section Scripts {
    <partial name="/Pages/Shared/_ChatInboxScripts.cshtml" />
}
