@page
@using GearZone.Domain.Enums
@model GearZone.Web.Pages.StoreOwner.Orders.IndexModel
@{
    ViewData["Title"] = "Orders";
    ViewData["PageHeader"] = "Orders";
    ViewData["ActivePage"] = "Orders";
    ViewData["Breadcrumb"] = new[] { "Orders" };
    Layout = "_StoreOwnerLayout";

    string GetBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-amber-50 text-amber-700 border border-amber-200",
        OrderStatus.Approved => "bg-sky-50 text-sky-700 border border-sky-200",
        OrderStatus.Paid => "bg-indigo-50 text-indigo-700 border border-indigo-200",
        OrderStatus.Processing => "bg-blue-50 text-blue-700 border border-blue-200",
        OrderStatus.Delivered => "bg-emerald-50 text-emerald-700 border border-emerald-200",
        OrderStatus.Cancelled => "bg-rose-50 text-rose-700 border border-rose-200",
        OrderStatus.Refunded => "bg-orange-50 text-orange-700 border border-orange-200",
        OrderStatus.Rejected => "bg-red-50 text-red-700 border border-red-200",
        _ => "bg-slate-50 text-slate-700 border border-slate-200"
    };
}

<div class="space-y-6">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="text-[11px] font-black uppercase tracking-[0.28em] text-orange-500">Minimal Seller Orders</p>
            <h1 class="mt-2 text-3xl font-black text-slate-900">Orders</h1>
            <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-500">This compact order desk exists to let sellers open buyer conversations directly from their recent shop orders.</p>
        </div>

        <form method="get" class="w-full max-w-md">
            <div class="relative">
                <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-slate-400">search</span>
                <input type="search"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       placeholder="Search by order code, buyer, or product"
                       class="w-full rounded-2xl border border-slate-200 bg-white py-3 pl-10 pr-4 text-sm text-slate-700 outline-none transition focus:border-orange-300 focus:ring-2 focus:ring-orange-200/60" />
            </div>
        </form>
    </div>

    <div class="overflow-hidden rounded-[1.8rem] border border-slate-200 bg-white shadow-soft">
        @if (!Model.Orders.Items.Any())
        {
            <div class="px-8 py-20 text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-500">
                    <span class="material-symbols-outlined text-[32px]">shopping_bag</span>
                </div>
                <h2 class="mt-5 text-xl font-bold text-slate-900">No orders found</h2>
                <p class="mt-2 text-sm leading-6 text-slate-500">Orders that belong to your store will appear here, along with a quick Contact Buyer action.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-5 py-4 text-left text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Order</th>
                            <th class="px-5 py-4 text-left text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Buyer</th>
                            <th class="px-5 py-4 text-left text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Items</th>
                            <th class="px-5 py-4 text-left text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Status</th>
                            <th class="px-5 py-4 text-left text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Subtotal</th>
                            <th class="px-5 py-4 text-right text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var order in Model.Orders.Items)
                        {
                            <tr class="hover:bg-slate-50/70">
                                <td class="px-5 py-4 align-top">
                                    <a asp-page="/StoreOwner/Orders/Detail"
                                       asp-route-subOrderId="@order.SubOrderId"
                                       class="text-sm font-black text-slate-900 hover:text-orange-600">
                                        #@order.OrderCode
                                    </a>
                                    <p class="mt-1 text-xs text-slate-500">@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                                </td>
                                <td class="px-5 py-4 align-top">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-full border border-slate-200 bg-slate-100 text-sm font-black text-slate-600">
                                            @if (!string.IsNullOrWhiteSpace(order.BuyerAvatarUrl))
                                            {
                                                <img src="@order.BuyerAvatarUrl" alt="@order.BuyerDisplayName" class="h-full w-full object-cover" />
                                            }
                                            else
                                            {
                                                @order.BuyerDisplayName[0]
                                            }
                                        </div>
                                        <div>
                                            <p class="text-sm font-bold text-slate-900">@order.BuyerDisplayName</p>
                                            <p class="mt-1 text-xs text-slate-500">@(order.DeliveredAt.HasValue ? $"Delivered {order.DeliveredAt.Value.ToLocalTime():dd MMM yyyy}" : "Not delivered yet")</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-4 align-top">
                                    <p class="text-sm font-semibold text-slate-800">@order.ProductPreview</p>
                                    <p class="mt-1 text-xs text-slate-500">@order.ItemCount item(s)</p>
                                </td>
                                <td class="px-5 py-4 align-top">
                                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] @GetBadgeClass(order.Status)">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="px-5 py-4 align-top text-sm font-black text-slate-900">@order.Subtotal.ToString("N0") VND</td>
                                <td class="px-5 py-4 align-top text-right">
                                    <div class="inline-flex items-center gap-2">
                                        @if (order.Status == OrderStatus.Pending)
                                        {
                                            <form method="post" asp-page-handler="Approve" asp-route-subOrderId="@order.SubOrderId" asp-route-searchTerm="@Model.SearchTerm" asp-route-pageNumber="@Model.PageNumber" class="inline">
                                                <button type="submit" class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-emerald-700 transition hover:-translate-y-0.5 hover:bg-emerald-100">
                                                    <span class="material-symbols-outlined text-[16px]">check_circle</span>
                                                    Approve
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="Reject" asp-route-subOrderId="@order.SubOrderId" asp-route-searchTerm="@Model.SearchTerm" asp-route-pageNumber="@Model.PageNumber" class="inline">
                                                <button type="submit" class="inline-flex items-center gap-2 rounded-full border border-rose-200 bg-rose-50 px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-rose-700 transition hover:-translate-y-0.5 hover:bg-rose-100">
                                                    <span class="material-symbols-outlined text-[16px]">cancel</span>
                                                    Reject
                                                </button>
                                            </form>
                                        }
                                        <a asp-page="/StoreOwner/Orders/Detail"
                                           asp-route-subOrderId="@order.SubOrderId"
                                           class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50">
                                            <span class="material-symbols-outlined text-[16px]">receipt_long</span>
                                            Details
                                        </a>
                                        <a asp-page="/StoreOwner/Messages/Index"
                                           asp-route-subOrderId="@order.SubOrderId"
                                           class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-orange-600 transition hover:-translate-y-0.5 hover:bg-orange-100">
                                            <span class="material-symbols-outlined text-[16px]">chat</span>
                                            Contact Buyer
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Orders.TotalPages > 1)
            {
                <div class="flex items-center justify-between gap-4 border-t border-slate-200 px-5 py-4">
                    <p class="text-sm text-slate-500">Page @Model.Orders.PageNumber of @Model.Orders.TotalPages</p>
                    <div class="flex items-center gap-2">
                        @if (Model.Orders.PageNumber > 1)
                        {
                            <a asp-page="/StoreOwner/Orders/Index"
                               asp-route-pageNumber="@(Model.Orders.PageNumber - 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               class="rounded-full border border-slate-200 px-3 py-2 text-xs font-black uppercase tracking-[0.14em] text-slate-600 transition hover:border-orange-200 hover:text-orange-600">
                                Previous
                            </a>
                        }
                        @if (Model.Orders.PageNumber < Model.Orders.TotalPages)
                        {
                            <a asp-page="/StoreOwner/Orders/Index"
                               asp-route-pageNumber="@(Model.Orders.PageNumber + 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               class="rounded-full border border-slate-200 px-3 py-2 text-xs font-black uppercase tracking-[0.14em] text-slate-600 transition hover:border-orange-200 hover:text-orange-600">
                                Next
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
