</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/@@goongmaps/goong-js/dist/goong-js.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@@goongmaps/goong-js/dist/goong-js.js"></script>

    <script>
        let currentVoucherType = 'order';
        const orderTotal = @Model.GrandTotal;
        let shippingFee = 0; // Dynamic value or from internal state
        let appliedVouchers = {
            order: null,
            shipping: null
        };

        function openVoucherModal(type) {
            currentVoucherType = type;
            document.getElementById('voucher-modal-title').textContent = type === 'order' ? 'Select Order Voucher' : 'Select Shipping Voucher';
            document.getElementById('voucher-modal-icon').textContent = type === 'order' ? 'sell' : 'local_shipping';
            document.getElementById('voucher-modal').classList.remove('hidden');
            document.getElementById('manual-voucher-code').value = '';
            document.getElementById('voucher-error').classList.add('hidden');
            document.body.style.overflow = 'hidden';

            loadAvailableVouchers(type);
        }

        function closeVoucherModal() {
            document.getElementById('voucher-modal').classList.add('hidden');
            document.body.style.overflow = '';
        }

        async function loadAvailableVouchers(type) {
            const listContainer = document.getElementById('voucher-list');
            listContainer.innerHTML = `<div class="flex flex-col items-center justify-center py-12 text-slate-400">
                                            <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-primary border-r-2 border-r-transparent mb-3"></div>
                                            <p>Finding best deals for you...</p>
                                        </div>`;

            try {
                const response = await fetch(`/Checkout/Index?handler=AvailableVouchers&type=${type}&orderTotal=${orderTotal}&shippingFee=${shippingFee}`);
                if (!response.ok) throw new Error('Failed to fetch vouchers');
                
                const vouchers = await response.json();
                
                if (vouchers.length === 0) {
                    listContainer.innerHTML = `<div class="text-center py-12 text-slate-400">
                                                  <span class="material-symbols-outlined text-4xl mb-2">sentiment_dissatisfied</span>
                                                  <p>No available vouchers found.</p>
                                               </div>`;
                    return;
                }

                listContainer.innerHTML = '';
                vouchers.forEach(v => {
                    const expiry = new Date(v.endAt).toLocaleDateString('vi-VN');
                    const isApplied = appliedVouchers[type]?.voucherCode === v.code;
                    
                    const card = document.createElement('div');
                    card.className = `group p-4 border-2 rounded-xl transition-all ${v.isEligible ? 'cursor-pointer hover:border-primary hover:bg-primary/5 border-slate-100 dark:border-slate-800' : 'opacity-60 grayscale cursor-not-allowed border-slate-50 dark:border-slate-900 bg-slate-50/50 dark:bg-slate-900/50'}`;
                    
                    if (v.isEligible) {
                        card.onclick = () => selectVoucher(v.code);
                    }

                    const discountTxt = v.discountType === 0 ? `${v.discountValue}% Off` : `${v.discountValue.toLocaleString('vi-VN')}₫ Off`;

                    card.innerHTML = `
                        <div class="flex items-start justify-between">
                            <div class="flex gap-4">
                                <div class="w-12 h-12 rounded-lg bg-white dark:bg-slate-800 shadow-sm border border-slate-100 dark:border-slate-700 flex items-center justify-center flex-shrink-0">
                                     <span class="material-symbols-outlined text-primary text-2xl">${type === 'order' ? 'sell' : 'local_shipping'}</span>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <h4 class="font-bold text-slate-900 dark:text-white">${v.name}</h4>
                                        <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-[10px] font-mono font-bold rounded border border-slate-200 dark:border-slate-700">${v.code}</span>
                                    </div>
                                    <p class="text-xs text-slate-600 dark:text-slate-400 mb-2">${discountTxt}${v.maxDiscount ? ` (Max ${v.maxDiscount.toLocaleString()}₫)` : ''}</p>
                                    <div class="flex items-center gap-3">
                                        <span class="text-[10px] text-slate-500 flex items-center gap-0.5">
                                            <span class="material-symbols-outlined text-[12px]">schedule</span>
                                            Expires: ${expiry}
                                        </span>
                                        ${v.minOrderAmount ? `
                                        <span class="text-[10px] text-slate-500 flex items-center gap-0.5">
                                            <span class="material-symbols-outlined text-[12px]">payments</span>
                                            Min: ${v.minOrderAmount.toLocaleString()}₫
                                        </span>` : ''}
                                    </div>
                                    ${!v.isEligible ? `<p class="mt-2 text-[10px] font-bold text-orange-500 flex items-center gap-1"><span class="material-symbols-outlined text-[12px]">info</span> ${v.ineligibleReason}</p>` : ''}
                                </div>
                            </div>
                            <div class="flex items-center">
                                ${isApplied ? `
                                    <span class="w-6 h-6 rounded-full bg-green-500 text-white flex items-center justify-center">
                                        <span class="material-symbols-outlined text-[18px]">check</span>
                                    </span>
                                ` : v.isEligible ? `
                                    <span class="w-6 h-6 rounded-full border-2 border-slate-200 dark:border-slate-700 group-hover:border-primary transition-colors"></span>
                                ` : ''}
                            </div>
                        </div>
                    `;
                    listContainer.appendChild(card);
                });
            } catch (error) {
                console.error(error);
                listContainer.innerHTML = `<div class="text-center py-12 text-red-500">Error loading vouchers.</div>`;
            }
        }

        async function selectVoucher(code) {
            await validateAndApply(code, currentVoucherType);
            closeVoucherModal();
        }

        async function applyManualVoucher() {
            const code = document.getElementById('manual-voucher-code').value.trim();
            if (!code) return;

            const errorEl = document.getElementById('voucher-error');
            errorEl.classList.add('hidden');

            const result = await validateAndApply(code, currentVoucherType);
            if (result.isValid) {
                closeVoucherModal();
            } else {
                document.getElementById('voucher-error-msg').textContent = result.errorMessage;
                errorEl.classList.remove('hidden');
            }
        }

        async function validateAndApply(code, type) {
            try {
                const response = await fetch(`/Checkout/Index?handler=ApplyVoucher`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ code: code, type: type, orderTotal: orderTotal, shippingFee: shippingFee })
                });

                const result = await response.json();
                if (result.isValid) {
                    appliedVouchers[type] = result;
                    updateVoucherUI(type);
                    calculateFinalTotal();
                }
                return result;
            } catch (error) {
                console.error(error);
                return { isValid: false, errorMessage: 'Network error. Please try again.' };
            }
        }

        function removeVoucher(type) {
            appliedVouchers[type] = null;
            updateVoucherUI(type);
            calculateFinalTotal();
        }

        function updateVoucherUI(type) {
            const row = document.getElementById(`${type}-voucher-row`);
            const actions = document.getElementById(`${type}-voucher-actions`);
            const applied = document.getElementById(`${type}-voucher-applied`);
            const label = document.getElementById(`${type}-voucher-label`);
            const status = document.getElementById(`${type}-voucher-status`);
            const hiddenInput = document.getElementById(`${type}-voucher-code-input`);

            const voucher = appliedVouchers[type];

            if (voucher) {
                actions.classList.add('hidden');
                applied.classList.remove('hidden');
                label.textContent = `${voucher.voucherCode} (-${voucher.discountAmount.toLocaleString()}₫)`;
                status.textContent = 'Voucher applied successfully';
                row.classList.remove('border-slate-200', 'dark:border-slate-700');
                row.classList.add('border-green-500', 'bg-green-50/10');
                hiddenInput.value = voucher.voucherCode;
            } else {
                actions.classList.remove('hidden');
                applied.classList.add('hidden');
                status.textContent = 'No voucher applied';
                row.classList.add('border-slate-200', 'dark:border-slate-700');
                row.classList.remove('border-green-500', 'bg-green-50/10');
                hiddenInput.value = '';
            }
        }

        function calculateFinalTotal() {
            const orderDiscount = appliedVouchers.order?.discountAmount || 0;
            const shippingDiscount = appliedVouchers.shipping?.discountAmount || 0;
            const shippingFee = 0; // Currently set to 0 in this version

            const subtotalEl = document.getElementById('summary-subtotal');
            const totalEl = document.getElementById('summary-total');
            
            // Order Discount Row
            const orderRow = document.getElementById('summary-order-discount-row');
            if (orderDiscount > 0) {
                orderRow.classList.remove('hidden');
                document.getElementById('summary-order-discount').textContent = `-${orderDiscount.toLocaleString()}₫`;
            } else {
                orderRow.classList.add('hidden');
            }

            // Shipping Discount Row
            const shippingRow = document.getElementById('summary-shipping-discount-row');
            if (shippingDiscount > 0) {
                shippingRow.classList.remove('hidden');
                document.getElementById('summary-shipping-discount').textContent = `-${shippingDiscount.toLocaleString()}₫`;
            } else {
                shippingRow.classList.add('hidden');
            }

            const finalTotal = orderTotal + shippingFee - orderDiscount - shippingDiscount;
            totalEl.textContent = `${Math.max(0, finalTotal).toLocaleString()}₫`;
        }

        // Initialize total calculation
        calculateFinalTotal();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/@@goongmaps/goong-js/dist/goong-js.js"></script>
    <script src="~/js/goong-autocomplete.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const apiKey = '@Model.GoongApiKey';
            const mapKey = '@Model.GoongMapKey';
            let map, marker;

            // Initialize Map
            const initMap = () => {
                const mapContainer = document.getElementById('checkout-map');
                if (!mapContainer || !mapKey) return;

                const initialLat = parseFloat(document.getElementById('shipping-lat-input')?.value || 21.028);
                const initialLng = parseFloat(document.getElementById('shipping-lng-input')?.value || 105.839);

                goongjs.accessToken = mapKey;
                map = new goongjs.Map({
                    container: 'checkout-map',
                    style: 'https://tiles.goong.io/assets/goong_map_web.json',
                    center: [initialLng, initialLat],
                    zoom: 15
                });

                marker = new goongjs.Marker()
                    .setLngLat([initialLng, initialLat])
                    .addTo(map);
                
                // Ensure map resizes correctly if container was hidden/loaded dynamically
                setTimeout(() => map.resize(), 500);
            };

            const updateMap = (lat, lng) => {
                if (!map || isNaN(lat) || isNaN(lng) || lat === 0) return;
                
                map.flyTo({
                    center: [lng, lat],
                    zoom: 16,
                    essential: true
                });
                marker.setLngLat([lng, lat]);
            };

            initMap();

            // ─── Goong Autocomplete ────────────────────────
            
            if (apiKey) {
                const streetInput = document.getElementById('shipping-address-input');
                const resultsElement = document.getElementById('goong-results');
                const latInput = document.getElementById('shipping-lat-input');
                const lngInput = document.getElementById('shipping-lng-input');

                if (streetInput && resultsElement) {
                    const wardInput = document.getElementById('shipping-ward-input');
                    const districtInput = document.getElementById('shipping-district-input');
                    const provinceInput = document.getElementById('shipping-province-input');

                    new GoongAutocomplete(apiKey, {
                        inputElement: streetInput,
                        resultsElement: resultsElement,
                        onSelect: (place) => {
                            console.log("Goong Place Selected:", place);
                            if (place.formatted_address) {
                                const components = place.address_components || [];
                                
                                if (place.original_description) {
                                    streetInput.value = place.original_description.split(',')[0].trim();
                                } else {
                                    const streetNumber = components.find(c => c.types.includes('street_number'))?.long_name;
                                    const route = components.find(c => c.types.includes('route'))?.long_name;
                                    
                                    if (streetNumber && route) {
                                        streetInput.value = `${streetNumber} ${route}`;
                                    } else {
                                        const fullParts = place.formatted_address.split(',').map(p => p.trim());
                                        if (fullParts.length > 1 && /^\d+[\/\d]*$/.test(fullParts[0])) {
                                            streetInput.value = `${fullParts[0]} ${fullParts[1]}`;
                                        } else {
                                            streetInput.value = fullParts[0];
                                        }
                                    }
                                }
                                
                                let ward = components.find(c => c.types.includes('sublocality_level_1') || c.types.includes('ward'))?.long_name;
                                let district = components.find(c => c.types.includes('administrative_area_level_2') || c.types.includes('district'))?.long_name;
                                let province = components.find(c => c.types.includes('administrative_area_level_1') || c.types.includes('city') || c.types.includes('province'))?.long_name;

                                if (!ward || !district || !province) {
                                    const parts = place.formatted_address.split(',').map(p => p.trim());
                                    if (parts.length >= 3) {
                                        province = province || parts[parts.length - 1];
                                        district = district || parts[parts.length - 2];
                                        ward = ward || (parts.length >= 4 ? parts[parts.length - 3] : null);
                                    }
                                }

                                if (ward && wardInput) { wardInput.value = ward || ''; wardInput.dispatchEvent(new Event('change')); }
                                if (district && districtInput) { districtInput.value = district || ''; districtInput.dispatchEvent(new Event('change')); }
                                if (province && provinceInput) { provinceInput.value = province || ''; provinceInput.dispatchEvent(new Event('change')); }
                                
                                if (latInput) latInput.value = place.geometry?.location?.lat || 0;
                                if (lngInput) lngInput.value = place.geometry?.location?.lng || 0;

                                if (place.geometry?.location) {
                                    updateMap(place.geometry.location.lat, place.geometry.location.lng);
                                }
                                
                                streetInput.dispatchEvent(new Event('change'));
                            }
                        }
                    });
                }
                
                // Initialize autocomplete for New Address Modal
                const modalStreetInput = document.getElementById('modal-new-address');
                const modalResultsElement = document.getElementById('modal-new-goong-results');
                if (modalStreetInput && modalResultsElement) {
                   new GoongAutocomplete(apiKey, {
                        inputElement: modalStreetInput,
                        resultsElement: modalResultsElement,
                        onSelect: (place) => {
                             if (place.formatted_address) {
                                const components = place.address_components || [];
                                
                                if (place.original_description) {
                                    modalStreetInput.value = place.original_description.split(',')[0].trim();
                                } else {
                                    const streetNumber = components.find(c => c.types.includes('street_number'))?.long_name;
                                    const route = components.find(c => c.types.includes('route'))?.long_name;
                                    if (streetNumber && route) {
                                        modalStreetInput.value = `${streetNumber} ${route}`;
                                    } else {
                                        modalStreetInput.value = place.formatted_address.split(',')[0].trim();
                                    }
                                }

                                let ward = components.find(c => c.types.includes('sublocality_level_1') || c.types.includes('ward'))?.long_name;
                                let district = components.find(c => c.types.includes('administrative_area_level_2') || c.types.includes('district'))?.long_name;
                                let province = components.find(c => c.types.includes('administrative_area_level_1') || c.types.includes('city') || c.types.includes('province'))?.long_name;

                                if (!ward || !district || !province) {
                                    const parts = place.formatted_address.split(',').map(p => p.trim());
                                    if (parts.length >= 3) {
                                        province = province || parts[parts.length - 1];
                                        district = district || parts[parts.length - 2];
                                        ward = ward || (parts.length >= 4 ? parts[parts.length - 3] : null);
                                    }
                                }

                                document.getElementById('modal-new-ward').value = ward || '';
                                document.getElementById('modal-new-district').value = district || '';
                                document.getElementById('modal-new-province').value = province || '';
                                
                                const lat = place.geometry?.location?.lat || 0;
                                const lng = place.geometry?.location?.lng || 0;
                                document.getElementById('modal-new-lat').value = lat;
                                document.getElementById('modal-new-lng').value = lng;
                                
                                updateModalMap(lat, lng);
                             }
                        }
                   });
                }
            }

            // ─── Payment Method Selection Highlight ────────
            const methodOptions = document.querySelectorAll('.payment-method-option');
            const radios = document.querySelectorAll('input[name="CheckoutRequest.PaymentMethod"]');

            function updateMethodStyles() {
                methodOptions.forEach(opt => {
                    const radio = opt.querySelector('input[type="radio"]');
                    if (radio && radio.checked) {
                        opt.classList.remove('border-slate-200', 'dark:border-slate-700');
                        opt.classList.add('border-primary', 'bg-primary/5');
                    } else {
                        opt.classList.remove('border-primary', 'bg-primary/5');
                        opt.classList.add('border-slate-200', 'dark:border-slate-700');
                    }
                });
            }

            radios.forEach(radio => {
                radio.addEventListener('change', updateMethodStyles);
            });

            updateMethodStyles();

            // ─── Address Modal Selection ────────────────────────
            const nameInput = document.querySelector('input[name="CheckoutRequest.ShippingInfo.FullName"]');
            const phoneInput = document.querySelector('input[name="CheckoutRequest.ShippingInfo.PhoneNumber"]');
            const addressInput = document.getElementById('shipping-address-input');
            const wardInput = document.getElementById('shipping-ward-input');
            const districtInput = document.getElementById('shipping-district-input');
            const provinceInput = document.getElementById('shipping-province-input');
            const latInputManual = document.getElementById('shipping-lat-input');
            const lngInputManual = document.getElementById('shipping-lng-input');

            window.openAddressModal = function() {
                const modal = document.getElementById('addressModal');
                const backdrop = document.getElementById('addressModalBackdrop');
                const content = document.getElementById('addressModalContent');
                
                modal.classList.remove('hidden');
                setTimeout(() => {
                    backdrop.classList.remove('opacity-0');
                    backdrop.classList.add('opacity-100');
                    content.classList.remove('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                    content.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
                }, 10);
                document.body.style.overflow = 'hidden';
            };

            window.closeAddressModal = function() {
                const modal = document.getElementById('addressModal');
                const backdrop = document.getElementById('addressModalBackdrop');
                const content = document.getElementById('addressModalContent');
                
                backdrop.classList.remove('opacity-100');
                backdrop.classList.add('opacity-0');
                content.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
                content.classList.add('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                
                setTimeout(() => {
                    modal.classList.add('hidden');
                    document.body.style.overflow = '';
                }, 300);
            };

            function updateSummaryCard(name, phone, address, ward, district, province) {
                document.getElementById('summary-fullname').textContent = name || "No Name";
                document.getElementById('summary-phone').textContent = phone || "No Phone";
                
                let fullAddress = address || "";
                if(fullAddress) {
                    fullAddress += ", " + (ward ? ward + ", " : "") + district + ", " + province;
                }
                const summaryAddressEl = document.getElementById('summary-address');
                if (fullAddress) {
                    summaryAddressEl.textContent = fullAddress;
                    summaryAddressEl.classList.remove('text-red-500', 'font-medium');
                    summaryAddressEl.classList.add('text-slate-600', 'dark:text-slate-400');
                } else {
                    summaryAddressEl.innerHTML = '<span class="text-red-500 font-medium">Please select a delivery address</span>';
                }
            }

            window.selectAddressFromModal = function(card) {
                const data = card.dataset;
                
                // Copy to hidden inputs
                if (nameInput) nameInput.value = data.name || '';
                if (phoneInput) phoneInput.value = data.phone || '';
                if (addressInput) addressInput.value = data.address || '';
                if (wardInput) wardInput.value = data.ward || '';
                if (districtInput) districtInput.value = data.district || '';
                if (provinceInput) provinceInput.value = data.province || '';
                if (latInputManual) latInputManual.value = data.lat || 0;
                if (lngInputManual) lngInputManual.value = data.lng || 0;

                // When selecting from existing, we don't save a new one or set new default
                const saveInput = document.getElementById('shipping-save-address-input');
                const defaultInput = document.getElementById('shipping-is-default-input');
                if (saveInput) saveInput.value = "false";
                if (defaultInput) defaultInput.value = "false";

                // Update UI Card
                updateSummaryCard(data.name, data.phone, data.address, data.ward, data.district, data.province);

                closeAddressModal();
            };

            // ─── New Address Modal Logic ────────────────────────
            
            let newAddressMap, newAddressMarker;
            
            window.openNewAddressModal = function() {
                closeAddressModal(); // Close the address book first
                
                // Clear modal fields
                document.getElementById('modal-new-fullname').value = '';
                document.getElementById('modal-new-phone').value = '';
                document.getElementById('modal-new-address').value = '';
                document.getElementById('modal-new-ward').value = '';
                document.getElementById('modal-new-district').value = '';
                document.getElementById('modal-new-province').value = '';
                
                if (window.setAddressType) setAddressType('Home');
                
                const modal = document.getElementById('newAddressModal');
                const backdrop = document.getElementById('newAddressModalBackdrop');
                const content = document.getElementById('newAddressModalContent');
                
                modal.classList.remove('hidden');
                setTimeout(() => {
                    backdrop.classList.remove('opacity-0');
                    backdrop.classList.add('opacity-100');
                    content.classList.remove('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                    content.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
                }, 10);
                document.body.style.overflow = 'hidden';
                
                setTimeout(() => { 
                    initNewAddressMap(); 
                    document.getElementById('modal-new-fullname').focus();
                }, 300);
            };

            window.closeNewAddressModal = function() {
                const modal = document.getElementById('newAddressModal');
                const backdrop = document.getElementById('newAddressModalBackdrop');
                const content = document.getElementById('newAddressModalContent');
                
                backdrop.classList.remove('opacity-100');
                backdrop.classList.add('opacity-0');
                content.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
                content.classList.add('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                
                setTimeout(() => {
                    modal.classList.add('hidden');
                    document.body.style.overflow = '';
                }, 300);
            };
            
            function initNewAddressMap() {
                const mapContainer = document.getElementById('modal-new-map');
                if (!mapContainer || !mapKey) return;

                if (!newAddressMap) {
                    goongjs.accessToken = mapKey;
                    // Default VN coord
                    newAddressMap = new goongjs.Map({
                        container: 'modal-new-map',
                        style: 'https://tiles.goong.io/assets/goong_map_web.json',
                        center: [106.660172, 10.762622], 
                        zoom: 15
                    });

                    newAddressMarker = new goongjs.Marker({ draggable: true })
                        .setLngLat([106.660172, 10.762622])
                        .addTo(newAddressMap);
                        
                    newAddressMarker.on('dragend', async () => {
                         const lngLat = newAddressMarker.getLngLat();
                         document.getElementById('modal-new-lat').value = lngLat.lat;
                         document.getElementById('modal-new-lng').value = lngLat.lng;
                         // Reverse geocode could be added here if needed
                    });
                }
                setTimeout(() => newAddressMap.resize(), 100);
            }
            
            function updateModalMap(lat, lng) {
                 if (!newAddressMap || isNaN(lat) || isNaN(lng) || lat === 0) return;
                 newAddressMap.flyTo({ center: [lng, lat], zoom: 16, essential: true });
                 newAddressMarker.setLngLat([lng, lat]);
            }

            window.confirmNewAddress = async function() {
                // Validation
                const name = document.getElementById('modal-new-fullname').value;
                const phone = document.getElementById('modal-new-phone').value;
                const address = document.getElementById('modal-new-address').value;
                const province = document.getElementById('modal-new-province').value;
                const ward = document.getElementById('modal-new-ward').value;
                const district = document.getElementById('modal-new-district').value;
                const lat = parseFloat(document.getElementById('modal-new-lat').value || 0);
                const lng = parseFloat(document.getElementById('modal-new-lng').value || 0);
                const isDefault = document.getElementById('modal-new-is-default').checked;
                const addressType = document.getElementById('modal-new-type').value || 'Home';
                
                if (!name || !phone || !address || !province) {
                    alert("Please fill in all required fields (Name, Phone, Address).");
                    return;
                }

                const btn = document.querySelector('button[onclick="confirmNewAddress()"]');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[20px]">sync</span> Saving...';
                btn.disabled = true;

                try {
                    const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    
                    const response = await fetch('?handler=AddNewAddress', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrfToken
                        },
                        body: JSON.stringify({
                            fullName: name,
                            phoneNumber: phone,
                            addressLine: address,
                            ward: ward,
                            district: district,
                            province: province,
                            latitude: lat,
                            longitude: lng,
                            isDefault: isDefault,
                            addressType: addressType
                        })
                    });

                    if (!response.ok) {
                        const errorData = await response.json().catch(() => ({}));
                        const msg = errorData.message || (errorData.errors ? errorData.errors.join(', ') : 'Failed to save address');
                        throw new Error(msg);
                    }
                } catch (error) {
                    console.error('Error saving address:', error);
                    alert('Error saving address: ' + error.message);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    return;
                }
                
                btn.innerHTML = originalText;
                btn.disabled = false;

                // Copy to hidden form inputs
                if (nameInput) nameInput.value = name;
                if (phoneInput) phoneInput.value = phone;
                if (addressInput) addressInput.value = address;
                if (wardInput) wardInput.value = ward;
                if (districtInput) districtInput.value = district;
                if (provinceInput) provinceInput.value = province;
                if (latInputManual) latInputManual.value = lat;
                if (lngInputManual) lngInputManual.value = lng;
                
                const typeInput = document.getElementById('shipping-type-input');
                if (typeInput) typeInput.value = addressType;
                
                const saveInput = document.getElementById('shipping-save-address-input');
                const defaultInput = document.getElementById('shipping-is-default-input');
                
                // If it was already saved directly to DB via AJAX, no need to save it again on form submission.
                if (saveInput) saveInput.value = "false";
                if (defaultInput) defaultInput.value = isDefault ? "true" : "false";

                // Update UI Summary Card
                updateSummaryCard(name, phone, address, ward, district, province);

                closeNewAddressModal();
            };

            window.setAddressType = function(type) {
                const typeInput = document.getElementById('modal-new-type');
                if (typeInput) typeInput.value = type;
                
                document.querySelectorAll('.type-selector-btn').forEach(btn => {
                    btn.classList.remove('border-primary', 'bg-primary/5', 'text-primary');
                    btn.classList.add('border-slate-200', 'text-slate-500', 'dark:border-slate-700', 'dark:text-slate-400');
                });
                
                const activeBtn = document.getElementById('typeBtn_' + type);
                if (activeBtn) {
                    activeBtn.classList.remove('border-slate-200', 'text-slate-500', 'dark:border-slate-700', 'dark:text-slate-400');
                    activeBtn.classList.add('border-primary', 'bg-primary/5', 'text-primary');
                }
            };

            // Esc key handles both modals
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') {
                    const addressModal = document.getElementById('addressModal');
                    const newAddressModal = document.getElementById('newAddressModal');
                    if(addressModal && !addressModal.classList.contains('hidden')) {
                        closeAddressModal();
                    }
                    if(newAddressModal && !newAddressModal.classList.contains('hidden')) {
                         closeNewAddressModal();
                    }
                }
            });

        });
    </script>
}
