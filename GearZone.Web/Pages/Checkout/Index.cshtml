                                <input type="text" id="manual-voucher-code" class="flex-1 px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl focus:border-primary outline-none transition-all uppercase placeholder:normal-case font-mono" placeholder="Enter code here..." />
                                <button type="button" onclick="applyManualVoucher()" class="px-6 py-2.5 bg-primary text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-md shadow-primary/20">
                                    Apply
                                </button>
