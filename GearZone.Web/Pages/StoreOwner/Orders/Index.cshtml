@page
@using GearZone.Domain.Enums
@model GearZone.Web.Pages.StoreOwner.Orders.IndexModel
@{
    ViewData["Title"] = "Order Management";
    ViewData["PageHeader"] = "Order Management";
    ViewData["ActivePage"] = "Orders";
    ViewData["Breadcrumb"] = new[] { "Orders" };
    Layout = "_StoreOwnerLayout";

    string GetStatusChipClass(OrderStatus status) => status switch
    {
        OrderStatus.Delivered => "bg-emerald-50 text-emerald-700 border border-emerald-200",
        OrderStatus.Processing => "bg-blue-50 text-blue-700 border border-blue-200",
        OrderStatus.Cancelled => "bg-rose-50 text-rose-700 border border-rose-200",
        OrderStatus.Completed => "bg-amber-50 text-amber-700 border border-amber-200",
        _ => "bg-slate-50 text-slate-700 border border-slate-200"
    };

    string TabClass(OrderStatus? status) => Model.Status == status
        ? "bg-primary text-white"
        : "text-slate-700 hover:bg-slate-100";
}

<div class="flex flex-col gap-6">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">@TempData["ErrorMessage"]</div>
    }

    <div class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
        <form method="get" id="filter-form" class="flex flex-wrap items-center gap-2">
            <input type="hidden" id="page-number-input" name="PageNumber" value="@Model.PageNumber" />
            <input type="hidden" id="sort-by-input" name="SortBy" value="@Model.SortBy" />
            <input type="hidden" id="sort-dir-input" name="SortDirection" value="@Model.SortDirection" />
            <input type="hidden" id="search-term-input" name="SearchTerm" value="@Model.SearchTerm" />
            <input type="hidden" id="min-subtotal-input" name="MinSubtotal" value="@Model.MinSubtotal" />
            <input type="hidden" id="max-subtotal-input" name="MaxSubtotal" value="@Model.MaxSubtotal" />
            <input type="hidden" id="date-shortcut-input" name="DateRangeShortcut" value="@Model.DateRangeShortcut" />
            <input type="hidden" id="date-range-input" name="DateRange" value="@Model.DateRange" />

            <button type="button" class="rounded-xl px-5 py-2.5 text-lg font-bold @TabClass(null)" onclick="setStatusAndSubmit('')">All Orders <span class="ml-1 text-sm">@Model.Stats.TotalOrders</span></button>
            <button type="button" class="rounded-xl px-5 py-2.5 text-lg font-bold @TabClass(OrderStatus.Processing)" onclick="setStatusAndSubmit('Processing')">Processing</button>
            <button type="button" class="rounded-xl px-5 py-2.5 text-lg font-bold @TabClass(OrderStatus.Delivered)" onclick="setStatusAndSubmit('Delivered')">Delivered</button>
            <button type="button" class="rounded-xl px-5 py-2.5 text-lg font-bold @TabClass(OrderStatus.Completed)" onclick="setStatusAndSubmit('Completed')">To Review</button>
            <button type="button" class="rounded-xl px-5 py-2.5 text-lg font-bold @TabClass(OrderStatus.Cancelled)" onclick="setStatusAndSubmit('Cancelled')">Cancelled</button>

            <input type="hidden" asp-for="Status" id="status-input" />
        </form>
    </div>

    @if (!Model.Orders.Items.Any())
    {
        <div class="rounded-2xl border border-slate-200 bg-white px-6 py-14 text-center shadow-sm">
            <p class="text-lg font-semibold text-slate-800">Không có don hàng phù h?p</p>
        </div>
    }
    else
    {
        foreach (var order in Model.Orders.Items)
        {
            <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-6 py-4">
                    <div class="flex items-center gap-3 text-base">
                        <span class="font-bold text-slate-900">@order.StoreName</span>
                        <span class="text-slate-300">|</span>
                        <span class="text-slate-600">Order #@order.OrderCode</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-sm text-slate-600">@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        <span class="rounded-xl px-3 py-1 text-sm font-bold @GetStatusChipClass(order.Status)">@order.Status</span>
                    </div>
                </div>

                <div class="px-6 py-5">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div class="flex min-w-0 flex-1 items-start gap-4">
                            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
                                <span class="material-symbols-outlined">inventory_2</span>
                            </div>
                            <div class="min-w-0">
                                <h3 class="truncate text-2xl font-bold text-slate-900">@order.ProductPreview</h3>
                                <p class="mt-1 text-lg text-slate-600">Quantity: @order.ItemCount</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-4xl font-black text-slate-900">@order.Subtotal.ToString("N0") VND</p>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 bg-slate-50/60 px-6 py-4">
                    <div>
                        <p class="text-3xl font-bold text-primary">Subtotal: @order.Subtotal.ToString("N0") VND</p>
                        <p class="text-sm text-slate-500">@(order.DeliveredAt.HasValue ? $"Delivered {order.DeliveredAt.Value.ToLocalTime():dd MMM yyyy HH:mm}" : "Chua giao")</p>
                    </div>

                    <div class="flex flex-wrap items-center gap-3">
                        <a asp-page="/StoreOwner/Orders/Detail" asp-route-subOrderId="@order.SubOrderId" class="rounded-xl border border-blue-200 bg-blue-50 px-5 py-2.5 text-lg font-bold text-blue-700 hover:bg-blue-100">Track Order</a>
                        <a asp-page="/StoreOwner/Messages/Index" asp-route-subOrderId="@order.SubOrderId" class="rounded-xl border border-amber-200 bg-amber-50 px-5 py-2.5 text-lg font-bold text-amber-700 hover:bg-amber-100">Chat Shop</a>
                        <button type="button" class="rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-lg font-bold text-slate-700">Visit Store</button>

                        @if (order.Status == OrderStatus.Pending)
                        {
                            <form method="post" asp-page-handler="Approve" asp-route-subOrderId="@order.SubOrderId" asp-route-searchTerm="@Model.SearchTerm" asp-route-pageNumber="@Model.PageNumber" asp-route-status="@Model.Status" asp-route-sortBy="@Model.SortBy" asp-route-sortDirection="@Model.SortDirection" asp-route-minSubtotal="@Model.MinSubtotal" asp-route-maxSubtotal="@Model.MaxSubtotal" asp-route-dateRangeShortcut="@Model.DateRangeShortcut" asp-route-dateRange="@Model.DateRange" class="inline">
                                <button type="submit" class="rounded-xl bg-primary px-5 py-2.5 text-lg font-bold text-white hover:bg-primary-dark">Approve</button>
                            </form>
                        }
                        else if (order.Status == OrderStatus.Approved || order.Status == OrderStatus.Paid)
                        {
                            <form method="post" asp-page-handler="MarkProcessing" asp-route-subOrderId="@order.SubOrderId" asp-route-searchTerm="@Model.SearchTerm" asp-route-pageNumber="@Model.PageNumber" asp-route-status="@Model.Status" asp-route-sortBy="@Model.SortBy" asp-route-sortDirection="@Model.SortDirection" asp-route-minSubtotal="@Model.MinSubtotal" asp-route-maxSubtotal="@Model.MaxSubtotal" asp-route-dateRangeShortcut="@Model.DateRangeShortcut" asp-route-dateRange="@Model.DateRange" class="inline">
                                <button type="submit" class="rounded-xl bg-primary px-5 py-2.5 text-lg font-bold text-white hover:bg-primary-dark">Mark Processing</button>
                            </form>
                        }
                        else if (order.Status == OrderStatus.Processing)
                        {
                            <form method="post" asp-page-handler="MarkDelivered" asp-route-subOrderId="@order.SubOrderId" asp-route-searchTerm="@Model.SearchTerm" asp-route-pageNumber="@Model.PageNumber" asp-route-status="@Model.Status" asp-route-sortBy="@Model.SortBy" asp-route-sortDirection="@Model.SortDirection" asp-route-minSubtotal="@Model.MinSubtotal" asp-route-maxSubtotal="@Model.MaxSubtotal" asp-route-dateRangeShortcut="@Model.DateRangeShortcut" asp-route-dateRange="@Model.DateRange" class="inline">
                                <button type="submit" class="rounded-xl bg-[#f4572e] px-5 py-2.5 text-lg font-bold text-white hover:opacity-90">Review Queue</button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="rounded-xl bg-[#f4572e] px-5 py-2.5 text-lg font-bold text-white hover:opacity-90">Review Queue</button>
                        }
                    </div>
                </div>
            </article>
        }

        @if (Model.Orders.TotalPages > 1)
        {
            <div class="flex items-center justify-end gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
                @if (Model.Orders.PageNumber > 1)
                {
                    <button type="button" onclick="gotoPage(@(Model.Orders.PageNumber - 1))" class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-700">Prev</button>
                }
                <span class="rounded-lg bg-primary px-3 py-1.5 text-white">@Model.Orders.PageNumber</span>
                @if (Model.Orders.PageNumber < Model.Orders.TotalPages)
                {
                    <button type="button" onclick="gotoPage(@(Model.Orders.PageNumber + 1))" class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-700">Next</button>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function setStatusAndSubmit(statusValue) {
            const statusInput = document.getElementById('status-input');
            const pageInput = document.getElementById('page-number-input');
            if (statusInput) statusInput.value = statusValue;
            if (pageInput) pageInput.value = '1';
            document.getElementById('filter-form')?.submit();
        }

        function gotoPage(page) {
            const pageInput = document.getElementById('page-number-input');
            if (pageInput) pageInput.value = page.toString();
            document.getElementById('filter-form')?.submit();
        }
    </script>
}
