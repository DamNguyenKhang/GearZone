@page
@using GearZone.Domain.Enums
@model GearZone.Web.Pages.StoreOwner.Vouchers.IndexModel
@{
    ViewData["Title"] = "Voucher Management";
    ViewData["PageHeader"] = "Voucher Management";
    ViewData["ActivePage"] = "Vouchers";
    ViewData["Breadcrumb"] = new[] { "Vouchers" };
    Layout = "_StoreOwnerLayout";
}

<div class="space-y-6">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <p class="text-xs font-black uppercase tracking-[0.24em] text-orange-500">Store Voucher Desk</p>
            <h1 class="mt-2 text-3xl font-black text-slate-900">Product Vouchers</h1>
            <p class="mt-2 text-sm text-slate-500">Create and manage seller vouchers for your products/orders. Shipping vouchers are not supported here.</p>
        </div>
        <a asp-page="/StoreOwner/Vouchers/Create" class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary-dark">
            <span class="material-symbols-outlined text-[20px]">add</span>
            Create Voucher
        </a>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Total Vouchers</p>
            <p class="mt-2 text-3xl font-black text-slate-900">@Model.Summary.TotalVouchers</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Active Today</p>
            <p class="mt-2 text-3xl font-black text-emerald-600">@Model.Summary.ActiveToday</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Redemption Rate</p>
            <p class="mt-2 text-3xl font-black text-indigo-600">@Model.Summary.RedemptionRate.ToString("0.##")%</p>
        </div>
    </div>

    <form method="get" class="rounded-xl border border-slate-200 bg-white p-4">
        <input type="hidden" asp-for="Query.PageNumber" />
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-6">
            <input asp-for="Query.Search" placeholder="Search by code or name" class="rounded-xl border-slate-200 text-sm xl:col-span-2" />

            <select asp-for="Query.Status" class="rounded-xl border-slate-200 text-sm">
                <option value="">All Statuses</option>
                @foreach (VoucherStatus status in Enum.GetValues(typeof(VoucherStatus)))
                {
                    if (status == VoucherStatus.Finished) continue;
                    <option value="@status">@status</option>
                }
            </select>

            <select asp-for="Query.DiscountType" class="rounded-xl border-slate-200 text-sm">
                <option value="">All Discount Types</option>
                <option value="Percent">Percent</option>
                <option value="FixedAmount">Fixed Amount</option>
            </select>

            <select asp-for="Query.CategoryId" class="rounded-xl border-slate-200 text-sm">
                <option value="">All Categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>

            <div class="flex gap-2">
                <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-800">
                    <span class="material-symbols-outlined text-[18px]">search</span>
                    Filter
                </button>
                <a asp-page="/StoreOwner/Vouchers/Index" class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-3 py-2 text-slate-600 transition hover:bg-slate-50" title="Reset">
                    <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                </a>
            </div>
        </div>
    </form>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        @if (!Model.PagedVouchers.Items.Any())
        {
            <div class="px-6 py-20 text-center">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-500">
                    <span class="material-symbols-outlined">confirmation_number</span>
                </div>
                <h2 class="mt-4 text-lg font-bold text-slate-900">No vouchers found</h2>
                <p class="mt-1 text-sm text-slate-500">Create your first product voucher to start promotions.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-5 py-3 text-left text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Voucher</th>
                            <th class="px-5 py-3 text-left text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Discount</th>
                            <th class="px-5 py-3 text-left text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Usage</th>
                            <th class="px-5 py-3 text-left text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Period</th>
                            <th class="px-5 py-3 text-left text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Status</th>
                            <th class="px-5 py-3 text-right text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var voucher in Model.PagedVouchers.Items)
                        {
                            <tr class="hover:bg-slate-50">
                                <td class="px-5 py-4 align-top">
                                    <p class="text-sm font-black text-slate-900">@voucher.Name</p>
                                    <p class="mt-1 text-xs font-semibold text-slate-500">@voucher.Code</p>
                                    <p class="mt-1 text-xs text-slate-400">@(voucher.CategoryName ?? "All categories")</p>
                                </td>
                                <td class="px-5 py-4 align-top text-sm text-slate-700">
                                    <p class="font-bold">
                                        @(voucher.DiscountType == DiscountType.Percent
                                            ? $"{voucher.DiscountValue:0.##}%"
                                            : $"{voucher.DiscountValue:N0} VND")
                                    </p>
                                    <p class="mt-1 text-xs text-slate-500">Min spend: @((voucher.MinOrderAmount ?? 0).ToString("N0")) VND</p>
                                    @if (voucher.DiscountType == DiscountType.Percent && voucher.MaxDiscount.HasValue)
                                    {
                                        <p class="text-xs text-slate-500">Max: @voucher.MaxDiscount.Value.ToString("N0") VND</p>
                                    }
                                </td>
                                <td class="px-5 py-4 align-top text-sm text-slate-700">
                                    <p><span class="font-bold">@voucher.UsedCount</span> / @voucher.UsageLimit</p>
                                </td>
                                <td class="px-5 py-4 align-top text-sm text-slate-700">
                                    <p>@voucher.StartAt.ToString("dd MMM yyyy HH:mm")</p>
                                    <p class="text-xs text-slate-500">@voucher.EndAt.ToString("dd MMM yyyy HH:mm")</p>
                                </td>
                                <td class="px-5 py-4 align-top">
                                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-bold @GearZone.Web.Pages.StoreOwner.Vouchers.IndexModel.GetStatusClass(voucher.Status)">
                                        @voucher.Status
                                    </span>
                                </td>
                                <td class="px-5 py-4 text-right align-top">
                                    <div class="inline-flex items-center gap-2">
                                        <a asp-page="/StoreOwner/Vouchers/Edit" asp-route-id="@voucher.Id" class="inline-flex items-center gap-1 rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100">
                                            <span class="material-symbols-outlined text-[16px]">edit</span>
                                            Edit
                                        </a>
                                        <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@voucher.Id" class="inline">
                                            <button type="submit" class="inline-flex items-center gap-1 rounded-full border px-3 py-1.5 text-xs font-semibold transition @(voucher.Status == VoucherStatus.Disabled ? "border-emerald-200 text-emerald-700 hover:bg-emerald-50" : "border-rose-200 text-rose-700 hover:bg-rose-50")">
                                                <span class="material-symbols-outlined text-[16px]">@(voucher.Status == VoucherStatus.Disabled ? "play_arrow" : "block")</span>
                                                @(voucher.Status == VoucherStatus.Disabled ? "Enable" : "Disable")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.PagedVouchers.TotalPages > 1)
            {
                <div class="flex items-center justify-between border-t border-slate-200 px-5 py-4">
                    <p class="text-sm text-slate-500">Page @Model.PagedVouchers.PageNumber of @Model.PagedVouchers.TotalPages</p>
                    <div class="flex items-center gap-2">
                        @if (Model.PagedVouchers.PageNumber > 1)
                        {
                            <form method="get">
                                <input type="hidden" name="Query.PageNumber" value="@(Model.PagedVouchers.PageNumber - 1)" />
                                <input type="hidden" name="Query.PageSize" value="@Model.Query.PageSize" />
                                <input type="hidden" name="Query.Search" value="@Model.Query.Search" />
                                <input type="hidden" name="Query.Status" value="@Model.Query.Status" />
                                <input type="hidden" name="Query.DiscountType" value="@Model.Query.DiscountType" />
                                <input type="hidden" name="Query.CategoryId" value="@Model.Query.CategoryId" />
                                <button type="submit" class="rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100">
                                    Previous
                                </button>
                            </form>
                        }
                        @if (Model.PagedVouchers.PageNumber < Model.PagedVouchers.TotalPages)
                        {
                            <form method="get">
                                <input type="hidden" name="Query.PageNumber" value="@(Model.PagedVouchers.PageNumber + 1)" />
                                <input type="hidden" name="Query.PageSize" value="@Model.Query.PageSize" />
                                <input type="hidden" name="Query.Search" value="@Model.Query.Search" />
                                <input type="hidden" name="Query.Status" value="@Model.Query.Status" />
                                <input type="hidden" name="Query.DiscountType" value="@Model.Query.DiscountType" />
                                <input type="hidden" name="Query.CategoryId" value="@Model.Query.CategoryId" />
                                <button type="submit" class="rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100">
                                    Next
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
