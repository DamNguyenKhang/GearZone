@page "/storeowner/dashboard"
@using GearZone.Domain.Enums
@model GearZone.Web.Pages.StoreOwner.DashboardModel
@{
    ViewData["Title"] = "Store Overview";
    ViewData["PageHeader"] = "Store Overview";
    ViewData["ActivePage"] = "Dashboard";
    ViewData["Breadcrumb"] = new string[] { "Dashboard" };
    Layout = "_StoreOwnerLayout";

    var maxRevenue = Model.RevenueByMonth.Any() ? Model.RevenueByMonth.Max(x => x.Revenue) : 0m;

    string GetOrderStatusBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-amber-50 text-amber-700",
        OrderStatus.AwaitingPayment => "bg-orange-50 text-orange-700",
        OrderStatus.Approved => "bg-sky-50 text-sky-700",
        OrderStatus.Paid => "bg-indigo-50 text-indigo-700",
        OrderStatus.Processing => "bg-blue-50 text-blue-700",
        OrderStatus.Delivered => "bg-emerald-50 text-emerald-700",
        OrderStatus.Completed => "bg-emerald-100 text-emerald-800",
        OrderStatus.Cancelled => "bg-rose-50 text-rose-700",
        OrderStatus.Refunded => "bg-orange-50 text-orange-700",
        OrderStatus.Rejected => "bg-red-50 text-red-700",
        _ => "bg-slate-50 text-slate-700"
    };

    string GetPayoutStatusBadgeClass(PayoutTransactionStatus status) => status switch
    {
        PayoutTransactionStatus.Queued => "bg-slate-50 text-slate-700",
        PayoutTransactionStatus.Processing => "bg-blue-50 text-blue-700",
        PayoutTransactionStatus.Success => "bg-emerald-50 text-emerald-700",
        PayoutTransactionStatus.Failed => "bg-red-50 text-red-700",
        PayoutTransactionStatus.ManualRequired => "bg-orange-50 text-orange-700",
        PayoutTransactionStatus.Excluded => "bg-slate-100 text-slate-600",
        _ => "bg-slate-50 text-slate-700"
    };
}

@if (!Model.HasStore)
{
    <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-card">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-500">
            <span class="material-symbols-outlined text-[28px]">store</span>
        </div>
        <h2 class="text-xl font-bold text-slate-900">No store data yet</h2>
        <p class="mt-2 text-sm text-slate-500">Your overview will appear after your store is approved and starts receiving orders.</p>
    </div>
}
else
{
    <div class="flex flex-col gap-6">
        <div class="rounded-xl border border-slate-100 bg-white p-5 shadow-card">
            <h2 class="text-lg font-bold text-slate-900">@Model.StoreName</h2>
            <p class="text-sm text-slate-500">Live performance snapshot of your store operations and payout status.</p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border border-slate-100 bg-white p-4 shadow-card">
                <div class="mb-3 flex items-center justify-between">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Orders</p>
                    <span class="material-symbols-outlined text-primary">receipt_long</span>
                </div>
                <h3 class="text-2xl font-bold text-slate-900">@Model.TotalOrders.ToString("N0")</h3>
            </div>
            <div class="rounded-xl border border-slate-100 bg-white p-4 shadow-card">
                <div class="mb-3 flex items-center justify-between">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Awaiting Action</p>
                    <span class="material-symbols-outlined text-amber-600">pending_actions</span>
                </div>
                <h3 class="text-2xl font-bold text-slate-900">@Model.PendingOrders.ToString("N0")</h3>
            </div>
            <div class="rounded-xl border border-slate-100 bg-white p-4 shadow-card">
                <div class="mb-3 flex items-center justify-between">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Gross Revenue</p>
                    <span class="material-symbols-outlined text-indigo-600">payments</span>
                </div>
                <h3 class="text-2xl font-bold text-slate-900">@Model.GrossRevenue.ToString("N0") VND</h3>
            </div>
            <div class="rounded-xl border border-slate-100 bg-white p-4 shadow-card">
                <div class="mb-3 flex items-center justify-between">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Pending Payout</p>
                    <span class="material-symbols-outlined text-orange-600">account_balance_wallet</span>
                </div>
                <h3 class="text-2xl font-bold text-slate-900">@Model.PendingPayoutAmount.ToString("N0") VND</h3>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
            <div class="rounded-xl border border-slate-100 bg-white p-6 shadow-card lg:col-span-3">
                <div class="mb-5 flex items-center justify-between">
                    <div>
                        <h3 class="text-base font-bold text-slate-900">Revenue (Last 6 Months)</h3>
                        <p class="text-sm text-slate-500">Monthly gross subtotal from your orders.</p>
                    </div>
                </div>
                <div class="flex h-64 items-end justify-between gap-3">
                    @foreach (var point in Model.RevenueByMonth)
                    {
                        var barHeight = maxRevenue > 0 ? Math.Max(8, (int)Math.Round(point.Revenue / maxRevenue * 100m)) : 8;
                        <div class="flex flex-1 flex-col items-center gap-2">
                            <div class="relative h-full w-full overflow-hidden rounded bg-slate-100">
                                <div class="absolute bottom-0 left-0 right-0 rounded-t bg-primary transition-all duration-500" style="height:@barHeight%"></div>
                            </div>
                            <span class="text-xs font-medium text-slate-600">@point.Label</span>
                            <span class="text-[10px] text-slate-400">@point.Revenue.ToString("N0")</span>
                        </div>
                    }
                </div>
            </div>

            <div class="rounded-xl border border-slate-100 bg-white p-6 shadow-card lg:col-span-2">
                <h3 class="text-base font-bold text-slate-900">Operations Snapshot</h3>
                <p class="mb-5 text-sm text-slate-500">High-level health for orders, chat, and payout.</p>
                <div class="space-y-4">
                    <div class="flex items-center justify-between rounded-lg bg-slate-50 px-4 py-3">
                        <span class="text-sm font-medium text-slate-600">Fulfilled Orders</span>
                        <span class="text-base font-bold text-slate-900">@Model.FulfilledOrders.ToString("N0")</span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg bg-slate-50 px-4 py-3">
                        <span class="text-sm font-medium text-slate-600">Paid Out</span>
                        <span class="text-base font-bold text-emerald-700">@Model.PaidOutAmount.ToString("N0") VND</span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg bg-slate-50 px-4 py-3">
                        <span class="text-sm font-medium text-slate-600">Conversations</span>
                        <span class="text-base font-bold text-slate-900">@Model.CustomerConversationCount.ToString("N0")</span>
                    </div>
                    <a asp-page="/StoreOwner/Messages/Index" class="flex items-center justify-between rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-sm font-semibold text-orange-700 transition-colors hover:bg-orange-100">
                        <span>Unread messages</span>
                        <span>@Model.CustomerUnreadCount.ToString("N0")</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <div class="overflow-hidden rounded-xl border border-slate-100 bg-white shadow-card">
                <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
                    <h3 class="font-bold text-slate-900">Recent Orders</h3>
                    <a asp-page="/StoreOwner/Orders/Index" class="text-sm font-medium text-primary hover:underline">View all</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-left text-sm">
                        <thead class="bg-slate-50/70 text-xs uppercase tracking-wider text-slate-500">
                            <tr>
                                <th class="px-5 py-3">Order</th>
                                <th class="px-4 py-3">Buyer</th>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-5 py-3 text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (Model.RecentOrders.Any())
                            {
                                foreach (var order in Model.RecentOrders)
                                {
                                    <tr class="hover:bg-slate-50">
                                        <td class="px-5 py-3">
                                            <a asp-page="/StoreOwner/Orders/Detail" asp-route-subOrderId="@order.SubOrderId" class="font-semibold text-slate-900 hover:text-primary">#@order.OrderCode</a>
                                            <p class="text-xs text-slate-500">@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                                        </td>
                                        <td class="px-4 py-3 text-slate-700">@order.BuyerName</td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @GetOrderStatusBadgeClass(order.Status)">
                                                @order.Status
                                            </span>
                                        </td>
                                        <td class="px-5 py-3 text-right font-semibold text-slate-900">@order.Subtotal.ToString("N0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="px-5 py-10 text-center text-slate-500">No recent orders yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="overflow-hidden rounded-xl border border-slate-100 bg-white shadow-card">
                <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
                    <h3 class="font-bold text-slate-900">Recent Payout Transactions</h3>
                    <a asp-page="/StoreOwner/Revenue/Index" class="text-sm font-medium text-primary hover:underline">Payout management</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-left text-sm">
                        <thead class="bg-slate-50/70 text-xs uppercase tracking-wider text-slate-500">
                            <tr>
                                <th class="px-5 py-3">Code</th>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-4 py-3 text-right">Amount</th>
                                <th class="px-5 py-3">Date</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (Model.RecentPayouts.Any())
                            {
                                foreach (var payout in Model.RecentPayouts)
                                {
                                    <tr class="hover:bg-slate-50">
                                        <td class="px-5 py-3 font-mono text-xs font-semibold text-slate-800">@payout.TransactionCode</td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @GetPayoutStatusBadgeClass(payout.Status)">
                                                @payout.Status
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-right font-semibold text-slate-900">@payout.NetAmount.ToString("N0")</td>
                                        <td class="px-5 py-3 text-slate-600">@payout.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="px-5 py-10 text-center text-slate-500">No payout records found yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
